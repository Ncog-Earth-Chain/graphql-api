# Copy to `.env` (next to docker-compose.yml) and fill in. `.env` is gitignored; this file is not.
#
#     cp .env.example .env
#     $EDITOR .env
#     docker compose up -d --build
#
# The two settings at the top have NO default. `docker compose up` refuses to start without them
# and tells you which one is missing. That is on purpose -- see the header of docker-compose.yml.

# ---------------------------------------------------------------------------- REQUIRED --

# Password for the explorer's own PostgreSQL. Generate one; do not reuse the validator's DDB
# password, and do not reuse it between environments.
#     openssl rand -base64 24 | tr -d '=+/'
#
# If it contains a character that is reserved in a URL (: / ? # [ ] @ % & = + $ , space) then
# either avoid those characters or set EXPLORER_PG_DSN below with the password percent-encoded --
# the DSN this stack builds does NOT encode it for you.
EXPLORER_PG_PASSWORD=

# RPC endpoint of the NCOG Earth Chain node this API reads. The node is NOT part of this stack.
#   http://host.docker.internal:18545   a node on this machine (works on Linux too: the compose
#                                       file maps that name to host-gateway). If the node binds
#                                       127.0.0.1 only, it will NOT be reachable this way --
#                                       start it with --http.addr 0.0.0.0 or put a forwarder in
#                                       front of it.
#   http://10.0.0.7:18545               a node elsewhere on the network
#   ws://node:18546                     WebSocket RPC
#   /var/run/ncog/ncogearthchain.ipc    a UNIX socket -- then also bind-mount it into the
#                                       container; IPC is the fastest and least exposed option
#                                       when the API and the node share a host.
# The node must expose the `eth` and `net` RPC namespaces and have transaction indexing enabled.
NEC_NODE_RPC_URL=

# ---------------------------------------------------------------------------- OPTIONAL --

# Explorer PostgreSQL identity. Changing these AFTER the volume has been initialised has no
# effect on the existing cluster -- POSTGRES_USER/DB are only read by initdb on an empty volume.
#EXPLORER_PG_USER=explorer
#EXPLORER_PG_DB=nec_explorer

# Where the two services are published on the host. Both default to loopback. 5442 rather than
# 5432 so this does not collide with a validator's DDB PostgreSQL on the same machine.
#EXPLORER_PG_BIND_ADDR=127.0.0.1
#EXPLORER_PG_PORT=5442
#EXPLORER_API_BIND_ADDR=127.0.0.1
#EXPLORER_API_PORT=16761

# Point the API at a PostgreSQL that this stack does not run. Overrides the DSN built from the
# variables above; the bundled `postgres` service then just sits there unused (comment it out).
# Use sslmode=require or verify-full for anything that leaves the host.
#EXPLORER_PG_DSN=postgres://explorer:PERCENT%2DENCODED@db.internal:5432/nec_explorer?sslmode=require

# Server behaviour. Unset means the application's own default applies
# (internal/config/default.go) -- these are not silently re-declared by the container.
#NEC_API_LOG_LEVEL=INFO
#NEC_API_CORS_ORIGINS=https://explorer.example.com,https://www.example.com
#NEC_API_PG_MAX_CONNS=16
#NEC_API_PG_MIN_CONNS=2
#NEC_API_RESOLVER_TIMEOUT=30
#NEC_API_WRITE_TIMEOUT=35

# Apply schema migrations at startup. Leave true unless you run them as a deliberate step:
#     docker compose --profile migrate run --rm migrate
#NEC_API_PG_AUTO_MIGRATE=true

# The GraphiQL IDE on /graphi is UNAUTHENTICATED and executes arbitrary queries against this API.
# Development stacks only, and never on a published address.
#NEC_API_GRAPHI_ENABLED=false

# Address of the SFC staking contract on the chain this API indexes.
#NEC_API_SFC_CONTRACT=0xFC00FACE00000000000000000000000000000000

# Image tag and build metadata.
#APISERVER_IMAGE=ncog-apiserver:latest
#APP_VERSION=1.1.0
#BUILD_COMMIT=
#BUILD_DATE=
